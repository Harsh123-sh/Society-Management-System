# Copy this file to .env and fill with real values
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name
PORT=5000
JWT_SECRET=replace_with_a_strong_secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback

FRONTEND_URL=http://localhost:5173

# Optional
# DB_PORT=5432
# NODE_ENV=development
# For local UI/API smoke tests when the remote DB is temporarily unreachable.
# Production should keep this unset or false.
# ALLOW_SERVER_WITHOUT_DB=false
